# Copiar a .env y ajustar. Nunca commitear .env real.

# DB_BACKEND: postgres (default) | mysql | mssql -- ver
# docs/design/0017-database-compatibility.md. Postgres sigue siendo el default recomendado
# (es el más probado); mysql se verificó end-to-end; mssql está soportado por el mismo
# código pero sin probar en este entorno (requiere el driver ODBC de Microsoft).
DB_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian
DB_USER=meridian
DB_PASSWORD=meridian_dev_only

# Alias viejos (POSTGRES_*) -- se siguen leyendo si DB_* no está definido, por si tenías
# un .env de antes de la compatibilidad multi-motor. No hace falta tener ambos.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

VAULT_ADDR=http://localhost:8200
# Vault usa almacenamiento persistente (no modo "dev") -- la primera vez que levantes el
# stack corre `meridianctl vault init` UNA VEZ, te va a dar un root token real. Pega ese
# valor aquí (ver docs/design/0016-vault-persistence.md).
VAULT_TOKEN=

MOCK_GATEWAY_PORT=8080

# Opcionales: cambia los puertos publicados al host si ya usas los defaults para otra cosa
# (ej. corriendo dos instalaciones de Meridian en paralelo). Si no los defines, se usan los
# defaults de siempre (5432/6379/8200).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# VAULT_HOST_PORT=8200

# Requeridos solo para `meridianctl dev up --subagents` -- ids de Postgres devueltos por
# `meridianctl subagent create` (ver docs/design/0003-entregable-2-status.md).
# SUBAGENT_A_ID=
# SUBAGENT_B_ID=

# Requeridos solo para `meridianctl dev up --research` (ejemplo opcional, ver README).
# PAPER_SEARCH_SUBAGENT_ID=
# PAPER_SUMMARIZER_SUBAGENT_ID=
